{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./*"] },
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["data", "types", "scripts"]
}
